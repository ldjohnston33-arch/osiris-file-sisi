# Osiris File: Sisi — environment variables. ALL are optional.
# With none set, the tool runs fully on free, keyless sources and uses
# rules-based text for the briefing and Analyst Read.

# Google Gemini (free key from https://aistudio.google.com/apikey).
# Enables the AI-written briefing and polished Analyst Read notes.
# GEMINI_API_KEY_1..8 are rotated round-robin if you add more than one.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Protects /api/ingest (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=

# Live vessel density on the Red Sea layer (free key from https://aisstream.io).
AIS_API_KEY=

# Rolling 180-day history + true "new since last visit" timestamps.
# Add the free Upstash Redis integration from the Vercel Marketplace and these
# are filled in for you (KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1 = count state-owned Egyptian outlets (e.g. Ahram) as state, not corroborating.
OSIRIS_STRICT_SOURCING=

# Public URL (used for social cards) and iframe embedding allow-list.
NEXT_PUBLIC_SITE_URL=
# FRAME_ANCESTORS='self' https://l4global.com https://*.l4global.com
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark
